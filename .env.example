# ======================= J.E.A.R.V.I.S. =======================
# IA
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Seguridad (OBLIGATORIO). Genera con:  openssl rand -hex 32
STARK_AUTH_TOKEN=

# Voz TARS (base neural + filtro robótico "tars"; JARVIS_VOICE_FX=none para voz limpia)
JARVIS_VOICE=es-MX-JorgeNeural
JARVIS_VOICE_RATE=-6%
JARVIS_VOICE_PITCH=-12Hz
JARVIS_VOICE_FX=tars
# Personalidad (0-100). También por voz: "TARS, humor al 60%"
TARS_HUMOR=75
TARS_HONESTY=90
ELEVENLABS_API_KEY=

# Modo: local (laptop, control directo del escritorio) | cloud (VPS, todo va al satélite)
JARVIS_MODE=local
# Permitir que el agente ejecute bash libre (por defecto: sí en local, no en cloud)
# JARVIS_ALLOW_CLI=true

# --- Solo VPS ---
# Dominio para HTTPS con Caddy (perfil "https")
JARVIS_DOMAIN=
# Token de túnel con nombre de Cloudflare (perfil "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=
# Orígenes extra con permiso CORS, separados por coma
JARVIS_ALLOWED_ORIGINS=

PORT=3000
